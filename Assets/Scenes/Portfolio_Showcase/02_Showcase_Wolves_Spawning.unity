--- !u!102 &674344766
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 674344764}
  m_Text: "Code: WolfSpawner.cs + BossWolf.cs\n\u2022 \u0E14\u0E48\u0E32\u0E19\u0E04\u0E35\u0E48\u0E25\u0E2D\u0E22\u0E25\u0E07
    | \u0E14\u0E48\u0E32\u0E19\u0E04\u0E39\u0E48\u0E25\u0E2D\u0E22\u0E02\u0E36\u0E49\u0E19
    + \u0E1A\u0E2D\u0E2A\u0E0A\u0E21\u0E1E\u0E39\u0E01\u0E23\u0E30\u0E1E\u0E23\u0E34\u0E1A\n\u2022
    \u0E2A\u0E25\u0E31\u0E1A BlowBalloon \u2192 Drop/Float \u0E15\u0E32\u0E21\u0E08\u0E23\u0E34\u0E07\n\u2022
    Boss Quota Lock: \u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E42\u0E04\u0E27\u0E15\u0E49\u0E32
    1 \u0E16\u0E36\u0E07\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E1A\u0E2D\u0E2A"
  m_OffsetZ: 0
