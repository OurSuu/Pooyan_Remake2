TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2037905146}
  m_Text: "Code: WolfSpawner.cs (\u0E02\u0E22\u0E31\u0E1A\u0E40\u0E25\u0E19\u0E17\u0E41\u0E22\u0E07\u0E21\u0E38\u0E21)\n\u2022
    \u0E2A\u0E38\u0E48\u0E21\u0E17\u0E34\u0E28 step = +1 \u0E2B\u0E23\u0E37\u0E2D
    -1 (\u0E02\u0E22\u0E31\u0E1A\u0E17\u0E35\u0E25\u0E30\u0E40\u0E25\u0E19)\n\u2022
    \u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E2B\u0E48\u0E32\u0E07\u0E01\u0E31\u0E19 0.5s
    \u0E14\u0E49\u0E27\u0E22 sharedSpeed \u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E19\n\u2022
    \u0E1A\u0E35\u0E1A\u0E43\u0E2B\u0E49\u0E1C\u0E39\u0E49\u0E40\u0E25\u0E48\u0E19\u0E02\u0E22\u0E31\u0E1A\u0E01\u0E23\u0E30\u0E40\u0E0A\u0E49\u0E32\u0E02\u0E36\u0E49\u0E19-\u0E25\u0E07\u0E23\u0E31\u0E1A\u0E21\u0E37\u0E2D"
