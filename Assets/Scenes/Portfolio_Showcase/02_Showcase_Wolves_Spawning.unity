--- !u!102 &660196882
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 660196880}
  m_Text: "9 \u0E09\u0E32\u0E01\u0E08\u0E33\u0E25\u0E2D\u0E07\u0E42\u0E04\u0E49\u0E14\u0E1D\u0E31\u0E48\u0E07\u0E2B\u0E21\u0E32\u0E1B\u0E48\u0E32:
    4 \u0E41\u0E1E\u0E15\u0E40\u0E17\u0E34\u0E23\u0E4C\u0E19\u0E42\u0E14\u0E14, Boss
    Lock, \u0E1A\u0E31\u0E19\u0E44\u0E14/\u0E14\u0E31\u0E19\u0E2B\u0E34\u0E19, \u0E25\u0E39\u0E01\u0E42\u0E1B\u0E48\u0E07\u0E14\u0E48\u0E32\u0E19\u0E04\u0E35\u0E48
    vs \u0E04\u0E39\u0E48, \u0E1A\u0E2D\u0E2A\u0E1B\u0E32\u0E1C\u0E25\u0E44\u0E21\u0E49\u0E02\u0E19\u0E32\u0E14\u0E08\u0E23\u0E34\u0E07
    \u0E41\u0E25\u0E30\u0E2A\u0E25\u0E31\u0E1A\u0E17\u0E34\u0E28\u0E42\u0E23\u0E22\u0E15\u0E31\u0E27\u0E25\u0E07
    \u2194 \u0E1A\u0E34\u0E19\u0E02\u0E36\u0E49\u0E19"
  m_OffsetZ: 0
  m_CharacterSize: 0.65
  m_LineSpacing: 1
