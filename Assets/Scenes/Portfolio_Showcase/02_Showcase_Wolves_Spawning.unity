TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1913024569}
  m_Text: "Code: WolfSpawner.cs (\u0E0B\u0E49\u0E2D\u0E19\u0E40\u0E25\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E19
    2-4 \u0E15\u0E31\u0E27)\n\u2022 \u0E43\u0E0A\u0E49 sharedSpeed \u0E40\u0E17\u0E48\u0E32\u0E01\u0E31\u0E19\u0E17\u0E31\u0E49\u0E07\u0E41\u0E16\u0E27\n\u2022
    \u0E2A\u0E39\u0E15\u0E23 stackDelay = 1.68f / sharedSpeed\n\u2022 \u0E40\u0E23\u0E35\u0E22\u0E07\u0E23\u0E30\u0E22\u0E30\u0E41\u0E19\u0E27\u0E15\u0E31\u0E49\u0E07\u0E40\u0E17\u0E48\u0E32\u0E01\u0E31\u0E19\u0E40\u0E1B\u0E4A\u0E30\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19
    Pooyan \u0E15\u0E49\u0E19\u0E09\u0E1A\u0E31\u0E1A"
  m_OffsetZ: 0
  m_CharacterSize: 0.65
  m_LineSpacing: 1
