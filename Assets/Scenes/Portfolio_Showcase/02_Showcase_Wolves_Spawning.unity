--- !u!102 &840738605
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 840738603}
  m_Text: "Code: WolfSpawner.cs (\u0E2B\u0E19\u0E49\u0E32\u0E01\u0E23\u0E30\u0E14\u0E32\u0E19\u0E42\u0E14\u0E14\u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E01\u0E31\u0E19!)\n\u2022
    \u0E2A\u0E39\u0E15\u0E23 spawnX = targetX - uniformWalkDistance\n\u2022 \u0E17\u0E38\u0E01\u0E15\u0E31\u0E27\u0E40\u0E14\u0E34\u0E19\u0E23\u0E30\u0E22\u0E30\u0E40\u0E17\u0E48\u0E32\u0E01\u0E31\u0E19
    \u2192 \u0E40\u0E1B\u0E48\u0E32\u0E25\u0E39\u0E01\u0E42\u0E1B\u0E48\u0E07\u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E01\u0E31\u0E19\n\u2022
    \u0E25\u0E2D\u0E22\u0E25\u0E07/\u0E02\u0E36\u0E49\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E41\u0E1C\u0E07\u0E2B\u0E19\u0E49\u0E32\u0E01\u0E23\u0E30\u0E14\u0E32\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E19\u0E40\u0E1B\u0E4A\u0E30"
  m_OffsetZ: 0
  m_CharacterSize: 0.65
  m_LineSpacing: 1
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 22
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 0}
  m_Color:
    serializedVersion: 2
    rgba: 4294634459
