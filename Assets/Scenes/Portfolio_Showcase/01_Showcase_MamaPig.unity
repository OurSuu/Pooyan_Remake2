--- !u!102 &1892138930
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1892138928}
  m_Text: "Code: Arrow.cs (DeflectDown -> StickIntoGround -> StickAndFadeRoutine)\n\u2022
    \u0E22\u0E34\u0E07\u0E42\u0E14\u0E19\u0E15\u0E31\u0E27\u0E2B\u0E21\u0E32\u0E1B\u0E48\u0E32
    (BiteArrow) / \u0E42\u0E25\u0E48 \u2192 \u0E18\u0E19\u0E39\u0E2B\u0E21\u0E38\u0E19
    90\xB0 \u0E14\u0E34\u0E48\u0E07\u0E25\u0E07\u0E1E\u0E37\u0E49\u0E19\u0E43\u0E19\u0E04\u0E2D\u0E25\u0E31\u0E21\u0E19\u0E4C\u0E40\u0E14\u0E34\u0E21
    (\u0E40\u0E08\u0E32\u0E30\u0E25\u0E39\u0E01\u0E42\u0E1B\u0E48\u0E07\u0E25\u0E48\u0E32\u0E07\u0E15\u0E48\u0E2D\u0E44\u0E14\u0E49)\n\u2022
    \u0E41\u0E15\u0E30\u0E1E\u0E37\u0E49\u0E19\u0E41\u0E25\u0E49\u0E27\u0E40\u0E2D\u0E35\u0E22\u0E07\u0E21\u0E38\u0E21\u0E2A\u0E38\u0E48\u0E21
    \xB18\xB0 + \u0E1D\u0E38\u0E48\u0E19 GroundDustImpactFX + \u0E2A\u0E31\u0E48\u0E19
    Quiver 0.15s + \u0E1B\u0E31\u0E01\u0E04\u0E49\u0E32\u0E07 1s \u0E41\u0E25\u0E49\u0E27\u0E08\u0E32\u0E07\u0E2B\u0E32\u0E22"
  m_OffsetZ: 0
  m_CharacterSize: 0.65
  m_LineSpacing: 1
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 24
  m_FontStyle: 0
  m_RichText: 1
