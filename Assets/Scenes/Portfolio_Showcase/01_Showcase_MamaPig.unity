  m_GameObject: {fileID: 743971009}
  m_Text: "Code: PlayerController.cs + MeatWeapon.cs + MeatPickupIndicator.cs\n\u2022
    \u0E02\u0E36\u0E49\u0E19\u0E16\u0E36\u0E07 maxY (IsAtTop) \u0E2B\u0E22\u0E34\u0E1A\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E08\u0E32\u0E01\u0E23\u0E2D\u0E01
    \u2192 \u0E41\u0E2A\u0E14\u0E07 HeldMeatVisual \u0E2A\u0E31\u0E14\u0E2A\u0E48\u0E27\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E1A\u0E40\u0E01\u0E21\u0E08\u0E23\u0E34\u0E07\n\u2022
    \u0E1B\u0E32 MeatSpring \u0E27\u0E34\u0E16\u0E35 2-Phase Parabolic + Soft Homing
    \u0E17\u0E30\u0E25\u0E38\u0E42\u0E25\u0E48 \u0E01\u0E27\u0E32\u0E14\u0E2B\u0E21\u0E32\u0E1B\u0E48\u0E32\u0E23\u0E48\u0E27\u0E07\u0E04\u0E2D\u0E21\u0E42\u0E1A
    (400\u2192800\u21921600+)"
  m_OffsetZ: 0
  m_CharacterSize: 0.65
  m_LineSpacing: 1
