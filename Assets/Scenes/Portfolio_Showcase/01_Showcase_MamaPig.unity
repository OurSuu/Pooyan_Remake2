  m_Script: {fileID: 11500000, guid: 99513968ad1858d47b4c1fe64387ca53, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PortfolioShowcaseStage
  showcaseTitle: "POOYAN REMAKE \u2014 SCENE 01: MAMA PIG & PIGLET LIVE SYSTEMS"
  showcaseSubtitle: "6 \u0E09\u0E32\u0E01\u0E08\u0E33\u0E25\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E17\u0E33\u0E07\u0E32\u0E19\u0E08\u0E23\u0E34\u0E07\u0E1D\u0E31\u0E48\u0E07\u0E41\u0E21\u0E48\u0E2B\u0E21\u0E39
    & \u0E25\u0E39\u0E01\u0E2B\u0E21\u0E39 (\u0E21\u0E35 Loop \u0E41\u0E22\u0E01\u0E41\u0E15\u0E48\u0E25\u0E30\u0E0A\u0E48\u0E2D\u0E07):
    \u0E22\u0E34\u0E07\u0E18\u0E19\u0E39\u0E41\u0E15\u0E01, \u0E1B\u0E32\u0E40\u0E19\u0E37\u0E49\u0E2D,
    \u0E42\u0E14\u0E19\u0E2B\u0E34\u0E19\u0E15\u0E32\u0E22, \u0E40\u0E01\u0E23\u0E32\u0E30\u0E01\u0E23\u0E30\u0E40\u0E0A\u0E49\u0E32,
    \u0E25\u0E39\u0E01\u0E2B\u0E21\u0E39\u0E14\u0E36\u0E07\u0E40\u0E0A\u0E37\u0E2D\u0E01
    \u0E41\u0E25\u0E30\u0E18\u0E19\u0E39\u0E23\u0E48\u0E27\u0E07\u0E1B\u0E31\u0E01\u0E1E\u0E37\u0E49\u0E19"
  overviewPos: {x: 0, y: 0.75, z: -10}
  overviewOrthoSize: 10.2
  topRowPos: {x: 0, y: 3.85, z: -10}
